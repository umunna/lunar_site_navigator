{
  "name": "lunar-landing-site-navigator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Lunar Landing Site Navigator: Sun/Earth geometry against the real local horizon for lunar landing sites. NASA Space Apps 2026 (Vienna).",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p packages/web/tsconfig.json --noEmit",
    "dev": "npm run dev --workspace @lsn/web",
    "build": "npm run build --workspace @lsn/web",
    "preview": "npm run preview --workspace @lsn/web",
    "lint": "eslint .",
    "test": "vitest run",
    "trace": "tsx packages/pipeline/src/cli/trace.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run trace",
    "fetch-ephemeris": "tsx packages/pipeline/src/cli/fetch-ephemeris.ts",
    "fetch-dem": "tsx packages/pipeline/src/cli/fetch-dem.ts",
    "gazetteer": "tsx packages/pipeline/src/cli/gazetteer-lookup.ts",
    "build-catalog": "tsx packages/pipeline/src/cli/build-catalog.ts",
    "build-skylines": "tsx packages/pipeline/src/cli/build-skylines.ts",
    "validate:unit": "tsx packages/pipeline/src/cli/validate-unit.ts",
    "validate:v0": "tsx packages/pipeline/src/cli/validate-v0.ts",
    "validate:v1": "tsx packages/pipeline/src/cli/validate-v1.ts",
    "validate:v3": "tsx packages/pipeline/src/cli/validate-v3.ts"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
